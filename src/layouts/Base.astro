---
import '../styles/foundation.css';
import '../styles/home.css';
import '../styles/sections.css';
import '../styles/editorial.css';
import '../styles/navigation.css'; // Shared paper-and-ink index navigation.
import '../styles/press-system.css'; // Shared printed objects, text, rules and compositions.
import '../styles/quiet-modules.css';
import '../styles/reading-flow.css';
import '../styles/body-emphasis.css';
import '../styles/editorial-tension.css';
import '../styles/portrait-flow.css';
import '../styles/portrait-composition.css';
import '../styles/print-material.css';
import '../styles/duotone-type.css';
import '../styles/home-main.css';
import '../styles/compact-layout.css';
import '../styles/reading-modes.css'; // Poster / Compact, applied last.
import '../styles/rhythm.css'; // Row sizes for boxes whose height follows their width.
import '../styles/home-layout.css'; // Home: poster and compact compositions.
import {design} from '../config/design';
import {aboutSections} from '../data/about-sections';
import {profile,pillars} from '../data/content';
import {resolve,styleText,designAttributes,areaIds} from '../design/settings';
const values=resolve(design).values;
import {emphasisBands} from '../design/emphasis-print';
import {emphasisMaterial} from '../design/emphasis';
import {getPalette} from '../design/settings';
const bands=emphasisBands(values,design),emTint=emphasisMaterial(getPalette(design,values.palette),values.emphasisPitch,values.emphasisCoverage).tint;
const emphasisVars=bands.map((b,i)=>`--em-band-${i}:${b}`).join(';')+`;--em-tint:${emTint}`;
---
<!doctype html>
<html lang="en">
 <head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  {import.meta.env.DEV&&<meta name="robots" content="noindex,nofollow"/>}
  <title>{import.meta.env.DEV?'Gengyuan Zhang — 排版与风格草案':'Gengyuan Zhang'}</title>
  <meta name="description" content={profile.bio}/>
  <link rel="canonical" href={Astro.site}/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=gz2"/>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=gz2"/>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=gz2"/>
  <meta property="og:type" content="website"/>
  <meta property="og:title" content="Gengyuan Zhang"/>
  <meta property="og:description" content={profile.bio}/>
  <meta property="og:url" content={Astro.site}/>
  <meta property="og:image" content={new URL('/images/portrait-composition.png',Astro.site)}/>

  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&amp;family=Newsreader:opsz,wght@6..72,400..600&amp;family=Inter:wght@400;500;600&amp;family=JetBrains+Mono:wght@400;500&amp;family=Instrument+Serif&amp;display=swap"/>
 </head>
 <body style={styleText({palette:values.palette},design)}>
  <div id="personal-site" style={`${styleText(values,design)};${emphasisVars}`} {...designAttributes(values)}>
   {/* Before first paint: choose the area from the URL so the first frame is the page that stays.
        Without JS this never runs and the four areas remain one stacked document. */}
   <script is:inline define:vars={{areas:[...areaIds],chapters:[...pillars.map(p=>p.id),"publications"],aboutAnchors:aboutSections.map(s=>s.id)}}>
    const root=document.currentScript.parentElement;let id='home';
    try{id=decodeURIComponent(location.hash.slice(1))||'home';}catch{}
    root.dataset.bootArea=areas.includes(id)?id:chapters.includes(id)?'research':aboutAnchors.includes(id)?'about':'home';
    root.dataset.booting='true';root.dataset.enhanced='true';
    // Reading mode before first paint (user, 2026-10-15): compact on desktop, poster on
    // phones, unless the reader chose one. Theme is a separate axis, light for now.
    let mode=null;try{mode=localStorage.getItem('reading-mode');}catch{}
    if(mode!=='compact'&&mode!=='poster')mode=matchMedia('(min-width: 900px)').matches?'compact':'poster';
    root.dataset.reading=matchMedia('(max-width: 720px)').matches?'poster':mode;root.dataset.theme='light';
   </script>
   <a class="skip-link" href="#site-content">跳到内容</a>
   <slot/>
   <span class="he-announcement" data-navigation-status aria-live="polite"/>
  </div>
  <script>import '../client/navigation';import '../client/moving-indicator';import '../client/artifacts';import '../client/reading-flow';import '../client/print-rules';import '../client/reading-mode';import '../client/portrait-composition';import '../client/print-material';import '../client/home-branches';import '../client/home-dividers';</script>
 </body>
</html>
