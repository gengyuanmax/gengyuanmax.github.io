---
import PrintTypeLine from './PrintTypeLine.astro';
import {design} from '../config/design';
import {resolve,styleText,designAttributes,type Area} from '../design/settings';
const {id,area,text}=Astro.props as {id:string;area:Area;text:string};
const s=resolve(design,area,id).values;
---
<span class="he-print-word" data-style-element={id} data-style-area-owner={area} {...designAttributes(s)} style={styleText(s,design)}>
 <PrintTypeLine text={text}/>
</span>
