---
import {design} from '../config/design';
import {resolve} from '../design/settings';
import {screen} from '../design/screen';
const {kind}=Astro.props as {kind:'chapter'|'news'};
const s=resolve(design,'home').values;
const lattice=screen('fine','b',s);
const size=lattice.pitch*Math.sqrt(s.homeDividerCoverage);
const radius=lattice.pitch*Math.sqrt(s.homeDividerCoverage/Math.PI);
---
<div class:list={['he-home-divider',`he-divider-${kind}`]} data-home-divider aria-hidden="true">
 {kind==='chapter'?<>
  <span class="he-divider-pass" data-divider-ink="a"><span class="he-divider-plate he-divider-plate-a"/></span>
  <span class="he-divider-pass" data-divider-ink="b"><span class="he-divider-plate he-divider-plate-b"/></span>
 </>:<span class="he-divider-pass" data-divider-ink="b"><span class="he-divider-band">
  <svg width="100%" height="100%" focusable="false"><defs><pattern id="home-news-screen" width={lattice.pitch} height={lattice.pitch} patternUnits="userSpaceOnUse" patternTransform={`rotate(${lattice.angle})`}>
   {lattice.shape==='square'?<rect x={(lattice.pitch-size)/2} y={(lattice.pitch-size)/2} width={size} height={size} fill="var(--blue-ink)"/>:<circle cx={lattice.pitch/2} cy={lattice.pitch/2} r={radius} fill="var(--blue-ink)"/>}
  </pattern></defs><rect width="100%" height="100%" fill="url(#home-news-screen)"/></svg>
 </span></span>}
</div>
