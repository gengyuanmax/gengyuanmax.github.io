---
import Styled from './Styled.astro';
import InkDefs from './InkDefs.astro';
import {design} from '../config/design';
import {resolve} from '../design/settings';
import {bridgeMarkup} from '../design/bridge';
const s=resolve(design,'home','home-bridge').values;
---
<Styled id="home-bridge" area="home" class="he-bridge" aria-hidden="true">
 <InkDefs element="home-bridge" area="home"/>
 <svg class="he-bridge-print" viewBox="0 0 1000 100" preserveAspectRatio="none" style="filter:url(#ink-home-bridge)" set:html={bridgeMarkup(s)}/>
</Styled>

<canvas class="he-portrait-flow" aria-hidden="true"/>
