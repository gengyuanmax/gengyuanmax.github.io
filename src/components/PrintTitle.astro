---
import Styled from './Styled.astro';
import InkDefs from './InkDefs.astro';
import type {Area} from '../design/settings';
interface Props {id:string;area:Area;lines:string[];class?:string;}
const {id,area,lines,class:className}=Astro.props;
---
<Styled as="h1" id={id} area={area} class={className} data-flow-label={lines.join(' ')}>
 <InkDefs element={id} area={area}/>
 {lines.map((line,index)=><span class="print-2ink he-type-line" style={`--letter-filter:url(#ink-${id})`}><span class="he-type-a" aria-hidden="true" data-ink-copy={line}></span><span class="he-type-b">{line}{index<lines.length-1?' ':''}</span></span>)}
</Styled>
