---
import PrintTypeLine from './PrintTypeLine.astro';
import Styled from './Styled.astro';
import type {Area} from '../design/settings';
interface Props {id:string;area:Area;lines:string[];class?:string;displayScreen?:boolean;}
const {id,area,lines,class:className,displayScreen=false}=Astro.props;
---
<Styled as="h1" id={id} area={area} class={className} data-flow-label={lines.join(' ')}>
 {lines.map((line,index)=><PrintTypeLine text={line+(index<lines.length-1?' ':'')} displayScreen={displayScreen}/>)}
</Styled>
