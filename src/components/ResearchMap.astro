---
import InkText from './InkText.astro';
import {staticResearchPreview} from '../design/research-static.mjs';
import {publishDataUrl} from '../design/static-files.mjs';
import {directions} from '../data/research-map';
import {researchRecipe} from '../design/research-render';
import {researchLabelArc} from '../design/research-geometry';
import '../styles/research-map.css';
import {design} from '../config/design';
import {resolve} from '../design/settings';
const s=resolve(design,'home').values,recipe=researchRecipe(s,design,640,undefined,{seed:resolve(design).values.seed,origin:{x:0,y:0},height:1440}),g=recipe.geometry;
// No-JS only; published as a file inside <noscript> (see PrintMotif).
const fallback=publishDataUrl(await staticResearchPreview(recipe),'research-map');
---
<div class="research-map" data-view={s.researchView} aria-describedby="research-map-description">
 <p id="research-map-description" class="rm-sr">Three horizontally overlapping ink circles represent research directions. Blue: {directions.find(d=>d.plate==='blue')!.label}; orange: {directions.find(d=>d.plate==='orange')!.label}; yellow: {directions.find(d=>d.plate==='yellow')!.label}. Follow a direction to explore its projects.</p>
 <div class="rm-diagram" aria-hidden="true"><noscript><img class="rm-fallback" src={fallback} width="640" height="400" alt="" loading="lazy" decoding="async"/></noscript><canvas class="rm-inks" width="640" height="400" aria-hidden="true"></canvas></div>
 <ol class="rm-directions">{directions.map(d=>{const arc=researchLabelArc(g,d.id,recipe.scale);return <li>
  <a data-memberships={d.id} href={d.href} aria-label={d.label}>
   <span class="rm-label-flat" aria-hidden="true"><InkText text={d.label}/></span>
   <svg class="rm-label-arc" viewBox="0 0 800 500" aria-hidden="true" focusable="false">
    <path id={`rm-label-${d.id}`} class="rm-label-hit" d={arc.path} stroke-width={28/recipe.scale}/>
    <g class="print-2ink rm-label-plates">
     {(['a','b'] as const).map(ink=><text class={`rm-label-${ink}`} aria-hidden="true" style={`font-size:${arc.fontSize}px`}><textPath href={`#rm-label-${d.id}`} startOffset="50%" text-anchor="middle">{d.label}</textPath></text>)}
    </g>
   </svg>
  </a>
 </li>})}</ol>
 <p class="rm-touch-help">Tap a label to highlight; tap again to clear. <a class="rm-open" hidden>Open highlighted link ↗</a></p>
</div>
<script>import '../client/research-map';</script>
