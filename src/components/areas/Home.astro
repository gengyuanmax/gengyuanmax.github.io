---
import InkText from '../InkText.astro';
import EmphasisText from '../EmphasisText.astro';
import {bodyEmphasis} from '../../config/body-emphasis';
import {homeBrandDraft} from '../../config/main-version';
import GridGuides from '../GridGuides.astro';
import PrintMedia from '../PrintMedia.astro';
import PrintTitle from '../PrintTitle.astro';
import PrintWord from '../PrintWord.astro';
import {profile,pillars,news,projects} from '../../data/content';
import {preferredResource} from '../../data/catalog';
const monthDate=(date:string)=>date.replace(/^\d{1,2} ([A-Za-z]{3} \d{4})$/,'$1');
---
<GridGuides />
<div class="he-home-profile">
 <PrintTitle id="home-name" area="home" class="he-name" lines={profile.name}/>
 <div class="he-intro" data-flow-label="简介与联系">
  <p class="he-role">{profile.role.map(part=><span>{part}<br /></span>)}</p>
  <p class="he-bio"><EmphasisText text={profile.bio} phrase={bodyEmphasis.home}/></p>
  <nav class="he-contact" aria-label="Profile links">{profile.contacts.slice(0,3).map(link=><a href={link.href}>{link.label}<span class="he-contact-arrow" aria-hidden="true">↗</span></a>)}</nav>
 </div>
 <PrintMedia />
</div>
<section class="he-home-research" aria-labelledby="research-core" data-flow-label="品牌与三个研究方向">
 <svg class="he-home-branches" aria-hidden="true"></svg>
 <div class="he-brand"><h2 id="research-core"><span class="he-slogan-prefix">{homeBrandDraft.prefix}</span><span class="he-slogan-core"><InkText text={homeBrandDraft.core}/></span></h2></div>
 <div class="he-research-overview"><ol class="he-pillars">{pillars.map((p,i)=><li>
  <span class="he-number"><InkText text={String(i+1).padStart(2,'0')}/></span>
  <div><h3><a href={`#${p.id}`}><InkText text={p.label}/></a></h3>
   <ul class="he-branch-papers">{Object.values(projects).filter(project=>project.primaryTheme===p.id).map(project=>{
    const resource=preferredResource(project.links);return resource&&<li><a href={resource.href}>{project.title}</a></li>;
   })}</ul>
  </div>
 </li>)}</ol></div>
</section>
<section data-flow-label="News" class="he-news" aria-labelledby="news-heading">
 <h2 id="news-heading"><PrintWord id="word-news" area="home" text="News"/></h2>
 <div class="he-news-scroll" role="region" aria-labelledby="news-heading" data-native-scroll><ol>{news.map(n=><li><span class="he-date">{monthDate(n.date)}</span><p><a href={n.href}>{n.text}</a></p></li>)}</ol></div>
</section>
