---
import ChapterIndicator from '../ChapterIndicator.astro';
import {definePrintElement,screenPrintElement} from '../../design/print-pipeline/index';
import {insertStack,stackHeight} from '../../design/insert-stack';
import {design} from '../../config/design';
import {resolve} from '../../design/settings';
import EmphasisText from '../EmphasisText.astro';
import {bodyEmphasis} from '../../config/body-emphasis';
import GridGuides from '../GridGuides.astro';
import Styled from '../Styled.astro';
import PrintTitle from '../PrintTitle.astro';
import PrintMotif from '../PrintMotif.astro';
import PrintWord from '../PrintWord.astro';
import MediaPlaceholder from '../MediaPlaceholder.astro';
import {formatMonth} from '../../data/dates';
import {artifacts,artifactCategories,sectionCopy} from '../../data/content';
import {artifactGroups,preferredResource,resourceEntries} from '../../data/catalog';
import {artifactComposition,placements} from '../../config/compositions';
const printLabStack=insertStack(resolve(design).values.seed).map(sheet=>({...sheet,src:screenPrintElement(definePrintElement({id:`artifact-print-labs-${sheet.id}`,profile:'insert',source:{kind:'graphic',src:sheet.src}}))}));
const wordIds:Record<string,string>={a:'word-printlab',b:'word-mosaic',c:'word-icq',d:'word-wikitilo',e:'word-mevtr'};
---
<GridGuides/>
<header class="he-artifacts-masthead"><PrintTitle id="artifacts-title" area="artifacts" lines={["Artifacts"]}/><p>{sectionCopy.artifacts}</p></header>
<div class="he-artifact-controls" hidden>
 <div role="group" data-moving-group="ordering" aria-label="Artifact ordering"><button type="button" data-artifact-mode="date" aria-pressed="true">By date</button><button type="button" data-artifact-mode="category" aria-pressed="false">By category</button><span data-moving-indicator class="he-shared-indicator"><ChapterIndicator id="artifact-mode" texture="knurl" class="he-mode-indicator"/></span></div>
 <label>Category <select data-artifact-filter><option value="all">All</option>{Object.entries(artifactCategories).map(([id,label])=><option value={id}>{label}</option>)}</select></label>
 <span class="he-announcement" data-artifact-status role="status"/>
</div>
<div class="he-artifact-groups">{<div class="he-artifact-spread" data-reading-host>{artifactGroups(Object.values(artifacts),'date')[0].entries.map((item,index)=>{
 const placement=artifactComposition[index%artifactComposition.length];const id=`artifact-${placement.id}`;const position=placements[id as keyof typeof placements];const resource=preferredResource(item.links);
 return <Styled as="article" id={id} area="artifacts" style={`--item-row:${position.row+Math.floor(index/artifactComposition.length)*3}`} data-flow-label={item.title} class={`he-artifact he-artifact-${placement.slot}`} data-content-id={`artifact-${item.id}`}>
 <span class="he-reading-marker" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>
 {item.id==='a'&&<div class="he-print-lab-overview"><a class="he-insert-stack" href={item.links?.page} style={`--stack-height:${stackHeight.toFixed(4)}`} aria-label="Explore Print Labs: print texture, layout, paper objects and elements">{printLabStack.map(sheet=><img class="he-insert-sheet" data-insert-sheet={sheet.id} src={sheet.src} style={sheet.style} width="249" height="320" alt="" loading="lazy" decoding="async"/>)}</a></div>}
 {item.id==='b'&&<PrintMotif id="mark-paper"/>}{item.id==='d'&&<PrintMotif id="mark-wikitilo"/>}{item.id==='e'&&<PrintMotif id="mark-mevtr"/>}
 {item.previewRatio&&<MediaPlaceholder ratio={item.previewRatio} label="[Artifact preview]"/>}<p class="he-item-meta">{item.featured&&<strong>Selected, </strong>}{item.form}, {item.publishedAt?<time datetime={item.publishedAt}>{formatMonth(item.publishedAt)}</time>:item.metadata}</p><h2>{resource?<a href={resource.href}><PrintWord id={wordIds[item.id]} area="artifacts" text={item.title}/><span class="he-external-mark" aria-hidden="true"> ↗</span></a>:item.title}</h2><p class="he-artifact-description"><EmphasisText text={item.description} phrase={bodyEmphasis.artifacts[item.id]}/></p><div class="he-project-resources">{resourceEntries(item.links).map(({kind,href})=><a href={href}>{kind==='page'?'Explore':kind==='github'?'GitHub':kind==='arxiv'?'arXiv':kind==='dataset'?'Dataset':kind==='model'?'Model':kind}</a>)}</div>
 </Styled>;
})}</div>}</div>

<script>
 import {insertStack} from '../../design/insert-stack';
 import {resolve,type DesignConfig} from '../../design/settings';
 document.querySelector('#personal-site')?.addEventListener('design:updated',event=>{
  const sheets=insertStack(resolve((event as CustomEvent<DesignConfig>).detail).values.seed);
  for(const sheet of sheets){const img=document.querySelector<HTMLElement>(`[data-insert-sheet="${sheet.id}"]`);if(img)img.style.cssText=sheet.style;}
 });
</script>
