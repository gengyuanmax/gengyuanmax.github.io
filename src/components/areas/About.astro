---
import ChapterIndicator from '../ChapterIndicator.astro';
import {aboutSections} from '../../data/about-sections';
import InkText from '../InkText.astro';
import EmphasisText from '../EmphasisText.astro';
import {bodyEmphasis} from '../../config/body-emphasis';
import PrintTitle from '../PrintTitle.astro';
import PrintMotif from '../PrintMotif.astro';
import QuietHeading from '../QuietHeading.astro';
import Styled from '../Styled.astro';
import {placements} from '../../config/compositions';
import {profile,experience,education,service} from '../../data/content';
const row=(name:string)=>`--item-row:${placements[`about-${name}` as keyof typeof placements].row}`;
import {aboutPhoto} from '../../config/about-photo';
---
<header class="he-about-masthead"><PrintTitle id="about-title" area="about" lines={["About me"]}/><figure class="he-about-folio he-about-photo" aria-hidden="true" style={`--media-ratio:${(aboutPhoto.crop.height/aboutPhoto.crop.width).toFixed(5)}`}><img src={aboutPhoto.output} width={aboutPhoto.width*aboutPhoto.scale} height={Math.round(aboutPhoto.width*aboutPhoto.scale*aboutPhoto.crop.height/aboutPhoto.crop.width)} alt="" decoding="async"/></figure></header>
<div class="he-about-body">
 <nav class="he-about-shortcuts" aria-label="About sections"><ChapterIndicator id="about-section-indicator" texture="wave"/>{aboutSections.map(s=><a href={`#${s.id}`} data-about-link={s.id}><span aria-hidden="true">{s.mark}</span>{s.label}</a>)}</nav>
 <Styled as="section" id="about-intro" area="about" class="he-about-module he-about-intro" style={row('intro')}>
  <p><EmphasisText text={profile.about} phrase={bodyEmphasis.about}/></p>
 </Styled>
 <Styled as="section" id="about-experience" anchorId="about-experience" data-about-section area="about" class="he-about-module he-about-experience" style={row('experience')}>
  <QuietHeading title="Experience" index="01"/>
  <ol class="he-timeline">{experience.map(e=><li><p class="he-item-meta">{e.date}</p><div class="he-timeline-content"><h3><InkText text={e.role}/></h3><p>{e.place}</p><p>{e.detail}</p></div></li>)}</ol>
 </Styled>
 <Styled as="section" id="about-education" anchorId="about-education" data-about-section area="about" class="he-about-module he-about-education" style={row('education')}>
  <QuietHeading title="Education" index="02" ground="ground-about-education"/>
  <ol class="he-timeline">{education.map(e=><li><p class="he-item-meta">{e.date}</p><div class="he-timeline-content"><h3><InkText text={e.degree}/></h3><p>{e.place}</p>{e.detail&&<p>{e.detail}</p>}</div></li>)}</ol>
 </Styled>
 <Styled as="section" id="about-funding" anchorId="about-funding" data-about-section area="about" class="he-about-module he-about-funding" style={row('funding')}>
  <QuietHeading title="Funding" ground="ground-about-funding"/><p class="he-item-meta">{service.funding}</p><p>{service.project}</p>
 </Styled>
 <Styled as="section" id="about-reviewing" anchorId="about-reviewing" data-about-section area="about" class="he-about-module he-about-reviewing" style={row('reviewing')}>
  <QuietHeading title="Reviewing"/><p>{service.reviewing}</p>
 </Styled>
 <Styled as="section" id="about-outside" anchorId="about-outside" data-about-section area="about" class="he-about-module he-about-outside" style={row('outside')}>
  <div class="he-personal-heading"><QuietHeading title="Outside research"/><PrintMotif id="mark-about"/></div><p>{profile.personal}</p>
 </Styled>
 <Styled as="section" id="about-contact" anchorId="about-contact" data-about-section area="about" class="he-about-module he-about-contact" style={row('contact')}>
  <QuietHeading title="Contact" index="03"/><nav class="he-contact" aria-label="Contact and profiles">{profile.contacts.map(link=><a href={link.href}>{link.label}<span class="he-contact-arrow" aria-hidden="true">↗</span></a>)}</nav>
 </Styled>
</div>
