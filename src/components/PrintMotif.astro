---
import {staticFieldPreview} from '../design/print-pipeline/field-static.mjs';
import Styled from './Styled.astro';
import {printObjects} from '../config/print-objects';
import {design} from '../config/design';
import {resolve,getPalette} from '../design/settings';
import {motifMarkup} from '../design/motifs';
import {publishDataUrl} from '../design/static-files.mjs';
const {id,class:className=''}=Astro.props as {id:keyof typeof printObjects;class?:string};
const {area,kind}=printObjects[id];
const settings=resolve(design,area,id).values;
// No-JS only (with JS the page shows paper until the live print is ready): a published file
// inside <noscript>, so visitors with JS never download it.
const fallback=publishDataUrl(await staticFieldPreview(settings,id,kind,getPalette(design,settings.palette),resolve(design).values.seed),`field-${id}`);
const plateHref=(dataUrl:string,ink:string,kind:string)=>publishDataUrl(dataUrl,`plate-${kind}-${ink}`);
---
<Styled as="span" id={id} area={area} class={`he-print-object ${className}`} aria-hidden="true">
 <noscript><img class="he-field-fallback" src={fallback} width="360" height="220" alt="" loading="lazy" decoding="async"/></noscript>
 <svg class="he-print-field" viewBox="0 0 360 220" data-print-field={id} data-print-kind={kind} data-print-area={area} set:html={motifMarkup(resolve(design,area,id).values,id,kind,plateHref)}/>
</Styled>
